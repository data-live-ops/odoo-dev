# Railway Environment Variables Template
# Copy this file and set your actual values in Railway dashboard

# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Odoo Configuration
ODOO_ADMIN_PASSWORD=your-strong-master-password-here
ODOO_DB_NAME=odoo_production

# WhatsApp Configuration
WHATSAPP_API_TOKEN=your-whatsapp-api-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# Metabase Configuration (if using)
METABASE_API_URL=https://metabase.your-domain.com
METABASE_USERNAME=your-metabase-username
METABASE_PASSWORD=your-metabase-password

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@domain.com
EMAIL_PASSWORD=your-email-password

# Security
SECRET_KEY=generate-a-random-secret-key-here
