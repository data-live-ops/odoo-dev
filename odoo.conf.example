[options]
# Database settings
db_host = db
db_port = 5432
db_user = odoo
db_password = CHANGE_ME
db_name = odoo_production

# Addons paths (include enterprise and custom)
addons_path = /usr/lib/python3/dist-packages/odoo/addons,/mnt/enterprise-addons,/mnt/custom-addons

# Server settings
http_port = 8069
longpolling_port = 8072

# Development mode (disable in production!)
# dev_mode = reload,qweb,werkzeug,xml

# Logging
log_level = info
log_handler = :INFO

# Security - CHANGE THIS!
admin_passwd = CHANGE_ME_STRONG_PASSWORD

# Proxy mode (enable for Railway/production)
proxy_mode = True

# Performance
workers = 2
max_cron_threads = 2

# Worker timeout settings
limit_time_cpu = 600
limit_time_real = 1200

# Without demo data
without_demo = all

# Disable GeoIP to avoid issues
geoip_database =

# Queue Job Configuration
server_wide_modules = base,web,queue_job
channels = root:1
