# Production Dockerfile for Railway
FROM odoo:18.0

# Switch to root to install additional packages
USER root

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Install additional Python dependencies
RUN python3 -m pip install --no-cache-dir --break-system-packages \
    phonenumbers \
    geoip2

# Create directories for custom addons and enterprise
RUN mkdir -p /mnt/custom-addons /mnt/enterprise-addons

# Copy custom modules to container
COPY --chown=odoo:odoo . /mnt/custom-addons/

# Copy enterprise modules to container
COPY --chown=odoo:odoo enterprise /mnt/enterprise-addons/

# Remove enterprise folder from custom-addons (avoid duplicate)
RUN rm -rf /mnt/custom-addons/enterprise

# Fix permissions
RUN chown -R odoo:odoo /mnt/custom-addons /mnt/enterprise-addons

# Create entrypoint script
COPY --chown=odoo:odoo docker-entrypoint-railway.sh /
RUN chmod +x /docker-entrypoint-railway.sh

# Switch back to odoo user
USER odoo

# Set working directory
WORKDIR /

# Expose Odoo ports
EXPOSE 8069 8072

# Use our custom entrypoint
ENTRYPOINT ["/docker-entrypoint-railway.sh"]
# No CMD needed - script calls odoo directly
