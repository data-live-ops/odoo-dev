<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="cl_whatsapp_templates.TemplatePicker">
        <div class="o_whatsapp_template_picker">
            <div class="o_template_picker_header">
                <h4>Select Template</h4>
                <input
                    type="text"
                    class="form-control mb-2"
                    placeholder="Search templates..."
                    t-model="state.searchTerm"
                />
                <select class="form-select mb-3" t-on-change="(ev) => this.onCategoryChange(ev.target.value)">
                    <option value="all">All Categories</option>
                    <option value="greeting">Greeting</option>
                    <option value="info">Information</option>
                    <option value="support">Support</option>
                    <option value="closing">Closing</option>
                    <option value="other">Other</option>
                </select>
            </div>

            <div class="o_template_picker_list">
                <t t-foreach="getFilteredTemplates()" t-as="template" t-key="template.id">
                    <div class="o_template_item card mb-2" t-on-click="() => this.onTemplateSelect(template.id)">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <h6 class="card-title mb-1">
                                    <t t-esc="template.name"/>
                                    <t t-if="template.shortcut">
                                        <span class="badge bg-primary ms-2"><t t-esc="template.shortcut"/></span>
                                    </t>
                                </h6>
                                <span class="badge bg-secondary"><t t-esc="template.category"/></span>
                            </div>
                            <p class="card-text text-muted small mb-1" t-if="template.description">
                                <t t-esc="template.description"/>
                            </p>
                            <p class="card-text small text-truncate mb-0">
                                <t t-esc="template.content"/>
                            </p>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
