<odoo>
    <record id="whatsapp_message_view_tree" model="ir.ui.view">
        <field name="name">whatsapp.message.view.tree.cl_helpdesk_whatsapp</field>
        <field name="model">whatsapp.message</field>
        <field name="inherit_id" ref="whatsapp.whatsapp_message_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="helpdesk_ticket_id"/>
            </xpath>
        </field>
    </record>
</odoo>
