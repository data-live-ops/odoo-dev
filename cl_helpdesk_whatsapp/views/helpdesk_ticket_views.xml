<odoo>
    <record id="helpdesk_ticket_view_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.view.form.cl_helpdesk_whatsapp</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='team_id']" position="attributes">
                <attribute name="required">false</attribute>
            </xpath>
            <xpath expr="//field[@name='team_id']" position="before">
                <field name="initiated_by" string="Initiated by" widget="radio" />
            </xpath>
            <xpath expr="//div[hasclass('o_row_readonly')]" position="after">
                <label for="student_phase" string="Student Phase" class="o_student_phase_label"/>
                <field name="student_phase" nolabel="1" />
                <field name="channel" />
            </xpath>
        </field>
    </record>
</odoo>