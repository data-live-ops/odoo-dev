<odoo>
    <record id="helpdesk_team_view_form_inherit" model="ir.ui.view">
        <field name="name">helpdesk.team.view.form.cl_helpdesk_whatsapp</field>
        <field name="model">helpdesk.team</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_team_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='productivity']/div[hasclass('col-lg-6')][last()]" position="after">
                <div class="col-lg-6">
                    <div class="o_setting_box">
                        <div>
                            <div class="o_form_label">Manage Student Phase</div>
                            <div class="text-muted">To automate team selection when student create a tickets.</div>
                            <div class="mt-3">
                                <div class="d-flex align-items-center mb-2">
                                    <field name="new_student" class="me-2" style="margin-bottom: 2px;"/>
                                    <label for="new_student" string="New Student" class="mb-0"/>
                                </div>
                                <div class="d-flex align-items-center mb-2">
                                    <field name="non_paid_student" class="me-2" style="margin-bottom: 2px;"/>
                                    <label for="non_paid_student" string="Non-Paid Student" class="mb-0"/>
                                </div>
                                <div class="d-flex align-items-center">
                                    <field name="paid_student" class="me-2" style="margin-bottom: 2px;"/>
                                    <label for="paid_student" string="Paid Student" class="mb-0"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
