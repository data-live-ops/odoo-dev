<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_metabase_config_form" model="ir.ui.view">
        <field name="name">metabase.config.form</field>
        <field name="model">metabase.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="student_details_question_url" invisible="1"/>
                    <field name="student_lead_stage_question_url" invisible="1"/>
                    <field name="parent_details_question_url" invisible="1"/>
                    <field name="subscription_data_question_url" invisible="1"/>
                    <button name="get_session_token" string="Get Session Token" type="object"/>
                    <button name="test_connection" string="Test Connection" type="object" class="oe_highlight"/>
                    <button name="action_notify_portcities" string="Notify Admin" type="object" invisible="1"/>
                    <button name="action_show_student_details" invisible="1" string="Show Student Details" type="object"/>
                    <button name="run_action_sync_students" string="Sync Students" invisible="not student_details_question_url" type="object" class="oe_highlight" help="Manually run the student synchronization"/>
                    <button name="run_action_sync_lead_stage" string="Sync Lead Stage" invisible="not student_lead_stage_question_url" type="object" class="oe_highlight" help="Manually run the lead stage synchronization"/>
                    <button name="run_action_sync_parents" string="Sync Parents" invisible="not parent_details_question_url" type="object" class="oe_highlight" help="Manually run the parent synchronization"/>
                    <button name="run_action_sync_student_subscriptions" string="Sync Subscriptions" invisible="not subscription_data_question_url" type="object" class="oe_highlight" help="Manually run the student subscription synchronization"/>
                    <button name="run_action_sync_student_attendance" string="Sync Attendance" invisible="not attendance_main_question_url" type="object" class="oe_highlight" help="Manually run the student attendance synchronization"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Configuration Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Connection Settings">
                            <field name="base_url" placeholder="e.g., https://metabase.example.com"/>
                            <field name="username"/>
                            <field name="password" password="True"/>
                            <field name="session_token" readonly="1"/>
                            <field name="session_expiry" readonly="1"/>
                            <field name="active"/>
                        </group>
                        <group string="Notification Settings">
                            <field name="email_notify" widget="email"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Question URLs" name="question_ids">
                            <group>
                                <group string="Student Data">
                                    <field name="student_details_question_url"/>
                                    <field name="parent_details_question_url"/>
                                    <field name="student_lead_stage_question_url"/>
                                </group>
                                <group string="Attendance Data">
                                    <field name="attendance_main_question_url"/>
                                    <field name="attendance_details_question_url"/>
                                </group>
                                <group string="Subscription Data">
                                    <field name="subscription_data_question_url"/>
                                </group>
                                <group string="Payment Data">
                                    <field name="slot_selection_succeeded_question_url"/>
                                    <field name="payment_received_question_url"/>
                                    <field name="paid_access_paused_question_url"/>
                                </group>
                            </group>
                        </page>
                        <page string="Retry Configuration">
                            <group>
                                <field name="max_retries"/>
                                <field name="retry_delay"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_metabase_config_list" model="ir.ui.view">
        <field name="name">metabase.config.list</field>
        <field name="model">metabase.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="base_url"/>
                <field name="username"/>
                <field name="session_expiry"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_metabase_config" model="ir.actions.act_window">
        <field name="name">Metabase API Config</field>
        <field name="res_model">metabase.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Metabase configuration
            </p>
            <p>
                Configure your Metabase connection to import contact data.
            </p>
        </field>
    </record>

    <menuitem id="menu_metabase_config"
              name="Metabase Settings"
              parent="base.menu_administration"
              action="action_metabase_config"
              sequence="100"/>
    
