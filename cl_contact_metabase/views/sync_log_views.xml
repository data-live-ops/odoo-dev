<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_metabase_sync_log_tree" model="ir.ui.view">
        <field name="name">metabase.sync.log.tree</field>
        <field name="model">metabase.sync.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="create_date"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="total_records"/>
                <field name="created_count"/>
                <field name="updated_count"/>
                <field name="sync_type"/>
                <field name="partner_id"/>
                <field name="state" decoration-success="state == 'done'" 
                       decoration-danger="state == 'failed'"
                       decoration-info="state == 'processing'"/>
            </list>
        </field>
    </record>

    <record id="view_metabase_sync_log_form" model="ir.ui.view">
        <field name="name">metabase.sync.log.form</field>
        <field name="model">metabase.sync.log</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_notify" string="Notify" type="object" class="oe_highlight" invisible="state != 'failed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sync_type" readonly="1"/>
                            <field name="data_type" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="start_date" readonly="1"/>
                            <field name="end_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_records" readonly="1"/>
                            <field name="created_count" readonly="1"/>
                            <field name="updated_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Error Message" invisible="not error_message">
                            <field name="error_message" widget="html" readonly="1"/>
                        </page>
                        <page string="Raw Response">
                            <field name="raw_response" widget="html" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_metabase_sync_log" model="ir.actions.act_window">
        <field name="name">Metabase Sync Logs</field>
        <field name="res_model">metabase.sync.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_metabase_sync_log"
              name="Metabase Sync Logs"
              action="action_metabase_sync_log"
              parent="contacts.menu_contacts"
              groups="base.group_system"
              sequence="120"/>
</odoo>