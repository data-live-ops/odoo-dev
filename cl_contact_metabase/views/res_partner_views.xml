<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend the partner form view -->
    <record id="view_partner_form_metabase_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.metabase.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="is_student" invisible="1"/>
                <button name="action_sync_manual_student" 
                        type="object"
                        class="oe_stat_button"
                        icon="fa-refresh"
                        invisible="not is_student"
                        string="Refresh from Metabase">
                </button>
            </xpath>
            
            <notebook position="inside">
                <page string="Student Info" name="student_info" invisible="not is_student">
                    <group>
                        <group string="Student Basic Information">
                            <field name="is_student" invisible="1"/>
                            <field name="metabase_user_id" readonly="1"/>
                            <field name="metabase_school" readonly="1"/>
                            <field name="metabase_city" readonly="1"/>
                            <field name="metabase_notification_consent" readonly="1"/>
                        </group>
                        <group string="Student Additional Information">
                            <field name="metabase_grade" readonly="1"/>
                            <field name="metabase_curriculum" readonly="1"/>
                            <field name="metabase_lead_status" readonly="1"/>
                            
                        </group>
                    </group>
                    <group name="student_sync_info" string="Student Sync Information" invisible="not is_student">
                        <field name="metabase_last_sync" readonly="1"/>
                        <field name="metabase_sync_log_id" readonly="1"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
