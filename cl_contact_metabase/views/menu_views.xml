<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main menu for Metabase integration -->
    <menuitem id="menu_metabase_root"
              name="Metabase"
              parent="contacts.menu_contacts"
              sequence="100"/>

    <!-- Configuration menu -->
    <menuitem id="menu_metabase_config"
              name="Configuration"
              parent="menu_metabase_root"
              action="action_metabase_config"
              sequence="10"/>
              
    <!-- Sync actions menu -->
    <record id="action_sync_contacts_from_metabase" model="ir.actions.server">
        <field name="name">Sync All Contacts from Metabase</field>
        <field name="model_id" ref="model_res_partner"/>
        <field name="binding_model_id" ref="model_res_partner"/>
        <field name="binding_view_types">form,list</field>
        <field name="state">code</field>
        <field name="code">
            action = model.sync_all_contacts_from_metabase()
        </field>
    </record>
    
    <menuitem id="menu_metabase_sync"
              name="Sync Contacts"
              parent="menu_metabase_root"
              action="action_sync_contacts_from_metabase"
              sequence="20"/>
</odoo>
