<odoo>

    <record id="view_partner_tree" model="ir.ui.view">
        <field name="name">view.partner.tree.cl_contact_base</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <list position="replace">
                <list>
                    <field name="contact_type"/>
                    <field name="name"/>
                    <field name="metabase_grade"/>
                    <field name="metabase_curriculum"/>
                    <field name="phone"/>
                    <field name="email"/>
                    <field name="city"/>
                    <field name="parent_type" optional="hide"/>
                    <field name="metabase_lead_status" optional="hide"/>
                    <field name="metabase_student_phase" optional="hide"/>
                </list>
            </list>
        </field>
    </record>

    <record id="view_res_partner_filter" model="ir.ui.view">
        <field name="name">cl.contact.base.inherit.view.res.partner.filter</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="after">
                <!-- Predefined Filters -->
                <filter name="student" string="Student" domain="[('contact_type','=','student')]"/>
                <filter name="parent" string="Parent" domain="[('contact_type','=','parent')]"/>
            </xpath>
            <xpath expr="//group/filter[@name='group_country']" position="after">
                <!-- Predefined Group By -->
                <filter name="group_contact_type" string="Contact Type" context="{'group_by':'contact_type'}"/>
                <filter name="group_grades" string="Grades" context="{'group_by':'metabase_grade'}"/>
                <filter name="group_lead_stage" string="Lead Stage" context="{'group_by':'metabase_lead_status'}"/>
                <filter name="group_student_phase" string="Student Phase" context="{'group_by':'metabase_student_phase'}"/>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">view.partner.form.cl_contact_base</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Form header customizations -->
            <xpath expr="//div[hasclass('oe_title')]" position="attributes">
                <attribute name="groups">base.group_erp_manager</attribute>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]/field[@name='company_type']" position="after">
                <div class="o_row">
                    <label for="contact_type"/>
                    <field name="contact_type" widget="radio" options="{'horizontal': true}"/>
                </div>
                <div class="o_row">
                    <label for="parent_type" invisible="contact_type == 'student'"/>
                    <field name="parent_type" invisible="contact_type == 'student'"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='parent_id']" position="after">
                <div class="o_row">
                    <field name="related_parent_id" widget="res_partner_many2one" placeholder="Parent Name..." invisible="contact_type == 'parent'"
                        domain="[('contact_type', '=', 'parent')]"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='vat']" position="before">
                <field name="metabase_user_id"/>
                <field name="metabase_parent_id" invisible="contact_type == 'student'"/>
                <field name="metabase_city"/>
                <field name="metabase_grade"/>
                <field name="metabase_school"/>
                <field name="metabase_curriculum"/>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="before">
                <field name="metabase_lead_status"/>
                <field name="metabase_student_phase"/>
                <field name="metabase_notification_consent"/>
            </xpath>
            <xpath expr="//field[@name='vat']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='website']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='function']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='internal_notes']" position="after">
                <!-- New tab 'Attendance' -->
                <page name='attendance' string="Attendance">
                    <field name="attendance_ids" readonly="1">
                        <list>
                            <field name="live_class_id" column_invisible="1"/>
                            <field name="class_subject"/>
                            <field name="class_topic"/>
                            <field name="teacher_name"/>
                            <field name="class_start_time"/>
                            <field name="time_of_joining"/>
                        </list>
                    </field>
                </page>
                <!-- New tab 'Subscription' -->
                <page name='subscription' string="Subscription">
                    <group>
                        <group>
                            <field name="subscription_id"/>
                            <field name="subscription_name"/>
                            <field name="status"/>
                            <field name="next_payment_date"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="cancellation_date"/>
                        </group>
                    </group>
                </page>
                <!-- New tab 'Payment' -->
                <page name='payment' string="Payment">
                    <field name="payment_ids" readonly="1">
                        <list>
                            <field name="rounded_opt_in_date"/>
                            <field name="course_batch_pairs"/>
                            <field name="paid_amount"/>
                            <field name="package_name"/>
                            <field name="payment_link" widget="url"/>
                            <field name="invoice_id"/>
                            <field name="payment_method"/>
                            <field name="payment_channel"/>
                            <field name="sales_agent_email"/>
                            <field name="payment_context"/>
                            <field name="payment_for_date"/>
                            <field name="retention_payment_type"/>
                            <field name="name"/>
                        </list>
                    </field>
                </page>
                <!-- New tab 'Sync Log' -->
                <page name='sync_log' string="Sync Log">
                    <field name="sync_log_ids" readonly="1">
                        <list>
                            <field name="last_sync_status" widget="badge"/>
                            <field name="last_manual_sync_status" widget="badge"/>
                            <field name="last_sync"/>
                            <field name="last_manual_sync"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
