<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contact Line Tree View -->
    <record id="view_contact_merge_contact_line_tree" model="ir.ui.view">
        <field name="name">contact.merge.contact.line.tree</field>
        <field name="model">contact.merge.contact.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="is_master" widget="boolean_toggle"/>
                <field name="name" readonly="1"/>
                <field name="mobile" readonly="1"/>
                <field name="phone" readonly="1"/>
                <field name="email" readonly="1"/>
                <field name="metabase_student_id" readonly="1"/>
                <field name="metabase_student_phase" readonly="1"/>
                <field name="create_date" readonly="1"/>
            </list>
        </field>
    </record>

    <!-- Duplicate Group Form View -->
    <record id="view_contact_merge_duplicate_group_form" model="ir.ui.view">
        <field name="name">contact.merge.duplicate.group.form</field>
        <field name="model">contact.merge.duplicate.group</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_merge" type="object" string="Merge Selected"
                            class="oe_highlight"
                            confirm="Are you sure you want to merge these contacts?"/>
                </header>
                <sheet>
                    <group>
                        <field name="normalized_phone"/>
                        <field name="contact_count"/>
                    </group>
                    <group string="Select Master Contact (Keep)" colspan="4">
                        <field name="contact_line_ids" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Contact Merge Wizard Form View -->
    <record id="view_contact_merge_wizard_form" model="ir.ui.view">
        <field name="name">contact.merge.wizard.form</field>
        <field name="model">contact.merge.wizard</field>
        <field name="arch" type="xml">
            <form string="Merge Duplicate Contacts">
                <header>
                    <button name="action_find_duplicates" type="object" string="Find Duplicates"
                            class="oe_highlight" invisible="total_duplicates > 0"/>
                    <button name="action_merge_all" type="object" string="Merge All (Auto)"
                            class="btn-warning" invisible="total_duplicates == 0"
                            confirm="This will automatically select master and merge all duplicate groups. Continue?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="total_duplicates" readonly="1"/> Duplicate Groups Found
                        </h1>
                    </div>

                    <notebook invisible="total_duplicates == 0">
                        <page string="Duplicate Groups">
                            <field name="duplicate_group_ids">
                                <list>
                                    <field name="normalized_phone" string="Phone Number"/>
                                    <field name="contact_count" string="Duplicates"/>
                                    <field name="master_contact_id" string="Master Contact"/>
                                    <button name="action_merge" type="object" string="Merge This Group"
                                            class="btn-primary" icon="fa-compress"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                    <div class="alert alert-info" role="alert" invisible="total_duplicates > 0">
                        <p>
                            <strong>How to use this tool:</strong><br/>
                            1. Click "Find Duplicates" to scan all contacts<br/>
                            2. Review duplicate groups found<br/>
                            3. For each group, select which contact to keep as master<br/>
                            4. Click "Merge" to combine duplicate contacts<br/><br/>
                            <em>Note: Duplicate contacts are identified by matching phone numbers (normalized format)</em>
                        </p>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action to open wizard -->
    <record id="action_contact_merge_wizard" model="ir.actions.act_window">
        <field name="name">Merge Duplicate Contacts</field>
        <field name="res_model">contact.merge.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
    </record>

    <!-- Menu item under Contacts -->
    <menuitem id="menu_contact_merge_wizard"
              name="Merge Duplicates"
              parent="contacts.menu_contacts"
              action="action_contact_merge_wizard"
              sequence="100"/>

</odoo>
